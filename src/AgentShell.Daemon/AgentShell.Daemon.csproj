<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AgentShell.Daemon</RootNamespace>
    <AssemblyName>agentshell-daemon</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- 自包含发布配置 -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>

    <!-- 发布元数据 -->
    <Description>AgentShell 守护进程 —— AI 编码代理的服务器端监控程序</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/jyh-agentshell/agentshell-daemon</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>Recommended</AnalysisMode>
  </PropertyGroup>

  <ItemGroup>
    <!-- AgentShell 协议模型（NuGet 引用） -->
    <!-- TODO(deferred-nuget-switch): protocol NuGet 包发布后切为 PackageReference -->
    <!-- <PackageReference Include="AgentShell.Protocol" Version="0.2.0" /> -->
    <ProjectReference Include="..\..\..\agentshell-protocol\src\AgentShell.Protocol\AgentShell.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ed25519 签名：.NET BCL 截至 .NET 10 未公开 Ed25519 类，使用 BouncyCastle（RFC 8032 纯托管实现，支持裁剪） -->
    <PackageReference Include="BouncyCastle.Cryptography" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="Tomlyn" />
  </ItemGroup>

</Project>
